# ============================================================
# BOS System - SQL Server 模式环境配置
# 使用方式：复制此文件为 .env
# 本配置使用 Windows 身份验证（无需 sa 密码）
# ============================================================

# 数据源切换：sqlserver
DATA_SOURCE=sqlserver

# 前端认证模式：jwt（配合 SQL Server 使用）
VITE_AUTH_MODE=jwt

# 后端 JWT 密钥（生产环境请使用长随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# SQL Server 连接配置
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=BOS_System
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERT=true

# 后端 API 基础地址
# 前后端同域名部署时留空，使用相对路径 /api
# 前后端分离部署时填写完整地址，如 http://localhost:3001/api
VITE_API_BASE_URL=

# DeepSeek 代理配置。不要把真实密钥提交到仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_PROMPT_LENGTH=20000
DEEPSEEK_MAX_BODY_SIZE=2mb

# CORS 允许的来源，逗号分隔
# 留空 = 全部放行（适合同源部署）
# 多个来源示例：http://localhost:5173,http://127.0.0.1:5173
# 全部放行：*
ALLOWED_ORIGINS=

# 前端可见变量
VITE_DEEPSEEK_API_URL=/api/deepseek
VITE_DIFFICULTY_API_URL=/api/difficulty-students

# API 请求体大小
API_MAX_BODY_SIZE=10mb

# 学校上报完整性校验项，逗号分隔；留空时默认启用全部五项。
DIFFICULTY_REPORT_REQUIRED_CHECKS=enrollment,family_members,photo,policy_document,status
