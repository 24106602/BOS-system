# ============================================================
# BOS System 环境变量配置 - 双数据源版
# 复制此文件为 .env 并填写实际值
# ============================================================

# ------------------------------------------------------------
# 认证模式
# supabase - 使用 Supabase Auth（原有方式）
# jwt      - 使用自建 JWT 认证（SQL Server 模式）
# ------------------------------------------------------------
VITE_AUTH_MODE=jwt

# ------------------------------------------------------------
# 数据源模式
# supabase - 前端直接连 Supabase（原有方式）
# api      - 前端通过后端 API 访问数据（SQL Server 模式推荐）
# ------------------------------------------------------------
VITE_DATA_SOURCE=api

# ------------------------------------------------------------
# 后端 API 地址（VITE_DATA_SOURCE=api 和 VITE_AUTH_MODE=jwt 时需要）
# 开发环境通常是 http://localhost:3001/api
# 生产环境填实际部署地址，或留空使用相对路径 /api
# ------------------------------------------------------------
VITE_API_BASE_URL=/api

# ------------------------------------------------------------
# Supabase 配置（VITE_AUTH_MODE=supabase 或 VITE_DATA_SOURCE=supabase 时需要）
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# SQL Server 配置（后端使用，DATA_SOURCE=sqlserver 时需要）
# ------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=BOS_System
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=your_password_here
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERT=true

# ------------------------------------------------------------
# 后端数据源选择（服务端使用）
# supabase  - 使用 Supabase 数据库
# sqlserver - 使用 SQL Server 数据库
# ------------------------------------------------------------
DATA_SOURCE=sqlserver

# ------------------------------------------------------------
# JWT 配置（VITE_AUTH_MODE=jwt 时需要，服务端使用）
# ------------------------------------------------------------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# 困难生后端 API
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY 只能配置在服务端，禁止使用 VITE_ 前缀
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_MAX_BODY_SIZE=10mb
VITE_DIFFICULTY_API_URL=/api/difficulty-students

# 学校上报完整性校验项，逗号分隔；留空时默认启用全部五项。
DIFFICULTY_REPORT_REQUIRED_CHECKS=enrollment,family_members,photo,policy_document,status

# ------------------------------------------------------------
# DeepSeek 代理配置。不要把真实密钥提交到仓库。
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_PROMPT_LENGTH=20000
DEEPSEEK_MAX_BODY_SIZE=2mb
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,null

# 前端可见变量，仅填写接口地址，不要写密钥。
VITE_DEEPSEEK_API_URL=/api/deepseek

# ------------------------------------------------------------
# 服务端口
# ------------------------------------------------------------
PORT=3001
